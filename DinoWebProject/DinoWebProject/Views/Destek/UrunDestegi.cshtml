@model DinoWebProject.Models.HomeViewModel.Class
<div class="rts-breadcrumb-area breadcrumb-bg bg_image">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 breadcrumb-1">
                <h1 class="title">Ürün Desteği</h1>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="bread-tag">
                    <a href="/Anasayfa/Index">Ana Sayfa</a>
                    <span> / </span>
                    <a href="#" class="active">Ürün Desteği</a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="rts-faq-area rts-section-gap inner">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-12 order-xl-1 order-md-2 order-sm-2 order-2">
                <div class="accordion-area inner">
                    <div class="title-area">
                        <span>Ürün Desteği</span>
                        <h2 class="title">Ürün Desteği</h2>
                    </div>
                    @foreach (var item in Model.Supports)
                    {
                        if (item.OrderNumber >= 1 && item.OrderNumber <= 13)
                        {
                            <div class="accordion-one-inner">
                                <div class="accordion" id="accordionExample2">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingOne">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne_@item.Id" aria-expanded="false" aria-controls="collapseOne_@item.Id">
                                                <span>@item.PageOrderNumber .</span>@item.Title
                                            </button>
                                        </h2>
                                        <div id="collapseOne_@item.Id" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample2">
                                            <div class="accordion-body">
                                                @item.Text
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
