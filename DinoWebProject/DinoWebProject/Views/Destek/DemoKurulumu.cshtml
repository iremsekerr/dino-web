@model DinoWebProject.Models.HomeViewModel.Class
<div class="rts-breadcrumb-area breadcrumb-bg bg_image">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 breadcrumb-1">
                <h1 class="title">Demo Kurulumu</h1>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="bread-tag">
                    <a href="/Anasayfa/Index">Ana Sayfa</a>
                    <span> / </span>
                    <a href="#" class="active">Demo Kurulumu</a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="rts-faq-area rts-section-gap inner">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-12 order-xl-1 order-md-2 order-sm-2 order-2">
                <div class="accordion-area inner inner2">
                    <div class="title-area">
                        <span>Demo Kurulumu</span>
                        <h2 class="title">Demo Kurulumu</h2>
                    </div>
                    @foreach (var item in Model.Supports.Where(x => x.OrderNumber >= 36 && x.OrderNumber <= 38))
                    {
                        <div class="accordion-one-inner inner inner2">
                            <div class="accordion" id="accordionExample5">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingOne">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse5_@item.Id" aria-expanded="false" aria-controls="collapseOne">
                                            <span>@item.PageOrderNumber .</span>@item.Title
                                        </button>
                                    </h2>
                                    <div id="collapse5_@item.Id" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample5">
                                        <div class="accordion-body">
                                            @item.Text
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
