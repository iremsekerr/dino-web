    <script>
        function checkCompanyName() {
            var companyName = document.getElementsByName("company_name")[0].value;
            var errorMessage = document.getElementById("error_message_company_name");

            if (companyName === "") {
                errorMessage.textContent = "Firma Ünvanı boş geçilemez.";
            } else {
                errorMessage.textContent = "";
            }
        }

       

        function checkTax() {
            var taxValue = document.getElementsByName("tax")[0].value;
            var errorMessage = document.getElementById("error_message_tax");

            if (taxValue === "") {
                errorMessage.textContent = "Vergi Dairesi boş geçilemez.";
            } else {
                errorMessage.textContent = "";
            }
        }

        function checkCompanyTaxNumber() {
            var taxNumber = document.getElementsByName("tax_number")[0].value;
            var errorMessage = document.getElementById("error_message_tax_number");

            if (taxNumber === "") {
                errorMessage.textContent = "Vergi Numarası boş geçilemez.";
            } else {
                errorMessage.textContent = "";
            }
        }
        function checkWebSite() {
            var taxNumber = document.getElementsByName("web-site")[0].value;
            var errorMessage = document.getElementById("error_message_web_site");

            if (taxNumber === "") {
                errorMessage.textContent = "Web Sitesi boş geçilemez.";
            } else {
                errorMessage.textContent = "";
            }
        }
        function checkApplicantName() {
            var taxNumber = document.getElementsByName("applicant_name")[0].value;
            var errorMessage = document.getElementById("error_message_applicant_name");

            if (taxNumber === "") {
                errorMessage.textContent = "Bu alan boş geçilemez.";
            } else {
                errorMessage.textContent = "";
            }
        }
    </script>
