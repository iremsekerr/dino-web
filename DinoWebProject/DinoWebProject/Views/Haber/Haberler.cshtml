@model DinoWebProject.Models.HomeViewModel.Class
<div class="rts-breadcrumb-area breadcrumb-bg bg_image">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 breadcrumb-1">
                <h1 class="title">Haberler</h1>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="bread-tag">
                    <a href="/Anasayfa/Index">Ana Sayfa</a>
                    <span> / </span>
                    <a href="#" class="active">Son Haberler</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end breadcrumb area -->
<!-- rts blog list area -->
<div class="rts-blog-list-area rts-section-gap">
    <div class="container">
        <div class="row g-5">
            <!-- rts blog post area -->
            <div class="col-xl-8 col-md-12 col-sm-12 col-12">
                <!-- single post -->
                @foreach (var item in Model.News)
                {
                    <div class="blog-single-post-listing">
                        <div class="thumbnail">
                            <img src="~/Images/News/@item.Img" style= "height:500px" alt="Business-Blog">
                        </div>
                        <div class="blog-listing-content">

                            <a class="blog-title" href="blog-details.html">
                                <h3 class="title">@item.Title</h3>
                            </a>
                            <p class="disc">
                                @item.Title
                            </p>
                            <a class="rts-btn btn-primary" href="/Haber/HaberDetay/@item.Id">Daha Fazla</a>
                        </div>
                    </div>
                }


                <!-- pagination area End -->
            </div>
            <!-- rts-blog post end area -->
            <!--rts blog wized area -->
            <div class="col-xl-4 col-md-12 col-sm-12 col-12 mt_lg--60">
                <!-- single wized start -->
                <div class="rts-single-wized search">
                    <div class="wized-header">
                        <h5 class="title">
                            Arayın
                        </h5>
                    </div>
                    <div class="wized-body">
                        <div class="rts-search-wrapper">
                            <input class="Search" type="text" placeholder="Aranacak Kelimeyi Girin">
                            <button><i class="fal fa-search"></i></button>
                        </div>
                    </div>
                </div>
                <!-- single wized End -->
                <!-- single wized start -->
                

                <div class="rts-single-wized Categories">
                    <div class="wized-header">
                        <h5 class="title">
                            Haberler
                        </h5>
                    </div>
                    @foreach (var item in ViewBag.modal)
                    {
                        <div class="wized-body">
                            <!-- single categoris -->
                            <ul class="single-categories">
                                <li><a href="/Haber/HberDetay/@item.Id">@item.Title <i class="far fa-long-arrow-right"></i></a></li>
                            </ul>

                            <!-- single categoris End -->
                        </div>
                    }
                    </div>
               

                <!-- single wized End -->
                <!-- single wized start -->
              
                <!-- single wized End -->
                <!-- single wized start -->
                <div class="rts-single-wized contact">
                    <div class="wized-header">
                        <a href="#"><img src="assets/images/logo/logo-2.svg" alt="Business_logo"></a>
                    </div>
                    <div class="wized-body">
                        <h5 class="title">
                            Yardıma İhtiyacınız Mı Var? Size Yardım İçin Buradayız
                        </h5>
                        <a class="rts-btn btn-primary" href="/Iletisim/Index">Bize Ulaşın</a>
                    </div>
                </div>
                <!-- single wized End -->
            </div>
            <!-- rts- blog wized end area -->
        </div>
    </div>
</div>
<!-- rts blog list area End -->