@model DinoWebProject.Models.HomeViewModel.Class
<div class="rts-breadcrumb-area breadcrumb-bg bg_image">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 breadcrumb-1">
                <h1 class="title">Haber Detayları</h1>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="bread-tag">
                    <a href="/Anasayfa/Index">Ana Sayfa</a>
                    <span> / </span>
                    <a href="#" class="active">Haber Detayları</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end breadcrumb area -->
<!-- rts blog mlist area -->
<div class="rts-blog-list-area rts-section-gap">
    <div class="container">
        <div class="row g-5">
            <!-- rts blo post area -->
            <div class="col-xl-8 col-md-12 col-sm-12 col-12">
                <!-- single post -->
                <div class="blog-single-post-listing details mb--0">
                    @foreach (var item in Model.News)
                    {<div class="thumbnail">
                            <img src="~/Images/News/@item.Img" alt="Business-Blog">
                        </div>

                        <h3 class="title">@item.Title</h3>

                        <p class="disc">
                            @item.Text
                        </p>

                    }

                    <!-- quote area start -->



                </div>

                <!-- rts- blog wizered end area -->
            </div>
            <div class="col-xl-4 col-md-12 col-sm-12 col-12">
                <!-- single wizered start -->
                <div class="rts-single-wized Categories service">
                    <div class="wized-header">
                        <h5 class="title">
                            Haberler
                        </h5>
                    </div>
                    @foreach (var item in ViewBag.modal)
                    {
                        <div class="wized-body">

                            <!-- single categoris -->
                            <ul class="single-categories">
                                <li><a href="/Haber/HaberDetay/@item.Id">@item.Title<i class="far fa-long-arrow-right"></i></a></li>
                            </ul>
                            <!-- single categoris End -->
                            <!-- single categoris End -->
                        </div>
                    }

                </div>

                <div class="rts-single-wized contact service">
                    <div class="wized-header">
                        <a href="#"><img src="assets/images/logo/logo-2.svg" alt="Business_logo"></a>
                    </div>
                    <div class="wized-body">
                        <h5 class="title">
                            Yardıma İhtiyacınız Mı Var?
                        </h5>
                        <a class="rts-btn btn-primary" href="/Iletisim/Index">Bize Ulaşın</a>
                    </div>
                </div>
                <!-- single wizered End -->
            </div>
        </div>
        <!-- single post End-->
    </div>
    <!-- rts-blog post end area -->
    <!--rts blog wizered area -->

</div>

