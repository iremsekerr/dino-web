
@{
    ViewBag.Title = "AddProduct";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <strong> ÜRÜN EKLE</strong>
            </div>
            <div class="card-body card-block">
                <form asp-controller="Admin" asp-action="AddProduct" method="post" enctype="multipart/form-data" class="form-horizontal">
                    <label><strong>Sıra Numarası</strong></label>
                    <input type="text" class="form-control" name="OrderNumber" />
                    <br />

                    <br />
                    <label><strong>Ürün Adı</strong></label>
                    <input type="text" class="form-control" name="Title" /><br />
                    <label><strong>Ürün Kısa Açıklaması</strong></label>
                    <input type="text" class="form-control" name="ShortText" /><br />
                    <br />

                    <br />
                    <label><strong>Ürün Görseli</strong></label><br />
                    <small class="text-muted" style="color:red !important">Lütfen görselin boyutunu 400x300 piksel olarak ayarlayın.</small>
                    <input type="file" name="Img" class="form-control" />
                    <label><strong>Ürün Tam Açıklaması</strong></label>
                    <input type="text" class="form-control" name="FullText" /><br />
                    <label><strong>Ürün Detay Görseli</strong></label><br />
                    <small class="text-muted" style="color:red !important">Lütfen detay görselinin boyutunu 500x500 piksel olarak ayarlayın.</small>
                    <input type="file" name="DetailImg" class="form-control" />
                    <label><strong>Ürün Fiyatı</strong></label>
                    <input type="number" class="form-control" name="Price" step="0.01" min="0" /><br />

                    <br />
                    <button class="btn btn-primary btn-sm">
                        <i class="fa fa-dot-circle-o"></i>ÜRÜN EKLE
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

