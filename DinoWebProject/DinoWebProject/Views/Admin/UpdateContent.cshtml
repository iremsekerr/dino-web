@model DinoWebProject.Models.Contents
@{
    ViewBag.Title = "UpdateContent";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h2>İçerik Güncelle</h2>


@using (Html.BeginForm("UpdateContent", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
<div class="form-group">
    @Html.Label("Sıra Numarası")
    @Html.TextBoxFor(x => x.OrderNumber, new { @class = "form-control" })
    <br /><br />
    @Html.Label("İçerik Adı")
    @Html.TextBoxFor(x => x.Title, new { @class = "form-control" })
   
    <br /> <br />
    @Html.Label("İçerik Açıklaması")
    @Html.TextAreaFor(x => x.FullText, new { @class = "form-control" })
   
    <br /> <br />
    @Html.Label("İçerik Görseli")
    <input type="file" src="~/Images/Content/x => x.Img" name="Img" class="form-control-file" />
    <br />
   

    <br /> <br />
    <button class="btn btn-success">Güncelle</button>

</div>
}

