
@model DinoWebProject.Models.Support
@{
    ViewBag.Title = "UpdateSupport";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h2>Destek İçeriği Güncelle</h2>


@using (Html.BeginForm("UpdateSupport", "Admin", FormMethod.Post))
{
    <div class="form-group">
        @Html.Label("Sıra Numarası")
        @Html.TextBoxFor(x => x.OrderNumber, new { @class = "form-control" })
        <br /><br />
        @Html.Label("İçerik Adı")
        @Html.TextBoxFor(x => x.Title, new { @class = "form-control" })
 
        <br /><br />
        @Html.Label("İçerik Açıklaması")
        @Html.TextBoxFor(x => x.Text, new { @class = "form-control" })
       
        <br /><br />
        @Html.Label("Destek Sayfasında Sıralaması")
        @Html.TextBoxFor(x => x.PageOrderNumber, new { @class = "form-control" })
     
        <br /> <br />
        <button class="btn btn-success">Güncelle</button>

    </div>
}

