
@{
    ViewBag.Title = "AddSupport";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <strong> DESTEK İÇERİĞİ EKLE</strong>
            </div>
            <div class="card-body card-block">
                <form asp-controller="Admin" asp-action="AddSupport" method="post" enctype="multipart/form-data" class="form-horizontal">
                    <label><strong>Sıra Numarası</strong></label>
                    <input type="text" class="form-control" name="OrderNumber" />
                    <br />

                    <br />
                    <label><strong>İçerik Başlığı</strong></label>
                    <input type="text" class="form-control" name="Title" /><br />
                    <label><strong>İçerik Açıklaması</strong></label>
                    <input type="text" class="form-control" name="Text" /><br />
                    <br />

                    <label><strong>Destek Sıralaması</strong></label>
                    <input type="text" class="form-control" name="PageOrderNumber" /><br />
                    <br />

                    <br />
                    <button class="btn btn-primary btn-sm">
                        <i class="fa fa-dot-circle-o"></i>DESTEK İÇERİĞİ EKLE
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

