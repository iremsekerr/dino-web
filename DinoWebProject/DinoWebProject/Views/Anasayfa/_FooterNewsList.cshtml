@model DinoWebProject.Models.HomeViewModel.NewsModel
<!-- single post -->
<div class="col-xl-4 col-md-6 col-sm-12 col-12">
    <div class="footer-one-single-wized margin-left-65">
        <div class="wized-title">
            <h5 class="title">Haberler</h5>
            <img src="~/assets/images/footer/under-title.png" alt="finbiz_footer">
        </div>
        <div class="post-wrapper">
            @foreach (var item in Model.News)
            {

                <div class="single-footer-post mb--30">
                    <div class="left-thumbnail" style="width:50%">
                        <img src="~/Images/News/@item.Img" alt="finbiz_business-post">
                    </div>
                    <div class="post-right"style="width:50%">

                        <a href="/Haber/HaberDetay/@item.Id">
                            <h6 class="title">
                                @item.Title
                            </h6>
                        </a>
                        <a class="red-more" href="/Haber/HaberDetay/@item.Id">Daha Fazla<i class="far fa-arrow-right"></i></a>
                    </div>
                </div>
            }

            
        </div>
    </div>
</div>

