@model DinoWebProject.Models.HomeViewModel.ProductModel

<div class="col-xl-4 col-md-6 col-sm-12 col-12">
    <div class="footer-one-single-wized">
        <div class="wized-title">
            <h5 class="title">Ürünler</h5>
            <img src="~/assets/images/footer/under-title.png" alt="finbiz_footer">
        </div>
        @foreach (var item in Model.Products)
        {
            <div class="quick-link-inner">

              
                    <ul class="links">
                        <li><a href="/Urun/UrunDetay/@item.Id"><i class="far fa-arrow-right"></i>@item.Title </a></li>

                    </ul>

               




            </div>
        }
    </div>
</div>