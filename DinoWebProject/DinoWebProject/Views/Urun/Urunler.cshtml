@model DinoWebProject.Models.HomeViewModel.Class


<!-- start breadcrumb area -->
<div class="rts-breadcrumb-area breadcrumb-bg bg_image">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 breadcrumb-1">
                <h1 class="title">Ürünlerimiz</h1>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="bread-tag">
                    <a href="/Anasayfa/Index">Ana Sayfa</a>
                    <span> / </span>
                    <a href="/Urun/Urunler" class="active">Ürünler</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end breadcrumb area -->
<!-- our service area start -->
<div class="rts-service-area rts-section-gapTop pb--200 service-two-bg bg_image">
    <div class="container">
        <div class="row g-5 service padding-controler">
            @foreach (var item in Model.Products)
            {
                <!-- single service area -->
                <div class="col-xl-4 col-md-6 col-sm-12 col-12 pb--140 pb_md--100">
                    <div class="service-two-inner">
                        <a href="/Urun/Index2" class="thumbnail"><img src="~/Images/Product/@item.Img" alt="Business_image" ></a>
                        <div class="body-content">
                            <div class="hidden-area">
                                <h5 class="title">@item.Title</h5>
                                <p class="dsic">
                                    @item.ShorText
                                </p>
                                <a class="rts-read-more-two color-primary" href="/Urun/UrunDetay/@item.Id">Daha Fazla<i class="far fa-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- single service area end-->

            }


        </div>
    </div>
</div>




